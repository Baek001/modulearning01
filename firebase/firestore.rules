rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function roomMember(roomId) {
      return get(/databases/$(database)/documents/messengerRooms/$(roomId)/members/$(request.auth.uid));
    }

    function isRoomMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/messengerRooms/$(roomId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if false;

      match /rooms/{roomId} {
        allow read, update: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId) || isAdmin();
        allow delete: if false;
      }
    }

    match /messengerRooms/{roomId} {
      allow read: if isRoomMember(roomId) || isAdmin();
      allow create: if signedIn();
      allow update: if isRoomMember(roomId) || isAdmin();
      allow delete: if false;

      match /members/{userId} {
        allow read: if isRoomMember(roomId) || isAdmin();
        allow create, update: if isAdmin() || (isSelf(userId) && request.resource.data.userId == request.auth.uid);
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId) || isAdmin();
        allow create: if isRoomMember(roomId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
