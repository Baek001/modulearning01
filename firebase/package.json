{
  "name": "starworks-firebase-workspace",
  "private": true,
  "scripts": {
    "deploy": "npx firebase-tools@latest deploy --config firebase.json",
    "emulators": "npx firebase-tools@latest emulators:start --config firebase.json",
    "codegen:dataconnect": "npx firebase-tools@latest dataconnect:sdk:generate --config firebase.json",
    "build:functions": "npm --prefix functions run build"
  }
}
