VITE_APP_BASE_URL=https://modulearning01.pages.dev

# Leave blank when the frontend is reverse-proxied to the backend on the same origin.
# Set this to your dedicated backend origin when Pages calls modulearning01-api directly.
# Example direct worker URL: https://modulearning01-api.<your-cloudflare-subdomain>.workers.dev
VITE_API_BASE_URL=

# Supabase client values must stay in frontend env files only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
