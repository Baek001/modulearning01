VITE_PLATFORM_BACKEND=firebase

VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
VITE_FIREBASE_LOGIN_DOMAIN=example.com
VITE_FIREBASE_USER_COLLECTION=users

VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
